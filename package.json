{
  "name": "booking-engine-no-conflict",
  "version": "2.0.0",
  "description": "Booking engine with zero conflicts - guaranteed no double bookings",
  "main": "server-updated.js",
  "type": "module",
  "scripts": {
    "dev": "node server-updated.js",
    "start": "NODE_ENV=production node server-updated.js",
    "build": "next build",
    "test": "node --test utils/__tests__/",
    "test:watch": "node --test --watch utils/__tests__/",
    "test:mongo:up": "docker run -d --rm --name wsbmt-test-mongo -p 37017:27017 mongo:5.0",
    "test:mongo:down": "docker stop wsbmt-test-mongo",
    "migrate:sparse": "node utils/migrateToSparseRows.js",
    "migrate:sparse:apply": "node utils/migrateToSparseRows.js --apply",
    "rollback:legacy": "node utils/rebuildLegacyTimeslots.js"
  },
  "dependencies": {
    "antd": "^5.22.2",
    "axios": "^1.14.0",
    "dayjs": "^1.11.12",
    "dotenv": "^16.0.3",
    "lodash": "^4.17.21",
    "mongodb": "^6.0.0",
    "next": "^16.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-fast-marquee": "^1.6.5",
    "socket.io": "^4.6.0",
    "socket.io-client": "^4.6.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.14",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "booking",
    "scheduling",
    "mongodb",
    "transactions",
    "no-conflicts",
    "real-time"
  ],
  "author": "",
  "license": "MIT"
}
